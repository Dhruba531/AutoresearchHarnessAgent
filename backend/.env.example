# Backend settings. Copy to backend/.env (gitignored); real environment
# variables override anything here.

# Where the SQLite database, uploads, artifacts and the generated secret live.
AGENTLAB_DATA_DIR=data
# DATABASE_URL=postgresql+psycopg://user:pass@host/agentlab

# Signs sessions and artifact links, and encrypts stored provider keys.
# Generated into $AGENTLAB_DATA_DIR/.secret_key when unset. Set it explicitly
# in production and keep it stable: rotating it invalidates saved keys.
# AGENTLAB_SECRET_KEY=

# auth: auto (Supabase tokens + local accounts) | supabase | local
AGENTLAB_AUTH=auto
AGENTLAB_ALLOW_REGISTRATION=true
# Supabase token verification. With SUPABASE_JWT_SECRET (HS256 projects) or a
# project using asymmetric signing keys, tokens verify locally; otherwise the
# backend asks Supabase, which needs the publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=

# Origins allowed to call the API with credentials.
AGENTLAB_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Spend controls.
AGENTLAB_MONTHLY_CAP_USD=50
AGENTLAB_MAX_ACTIVE_RUNS=2

# Let every user fall back to keys in this environment. Off by default: with
# it on, anyone who can sign up spends the operator's credits.
AGENTLAB_SERVER_KEYS=false
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Price override, USD per million tokens "input,output":
# AGENTLAB_PRICE_DEEPSEEK_REASONER=0.28,0.42

# Code execution: local (resource-limited subprocess on this host) | runpod | none
AGENTLAB_EXECUTION=local
AGENTLAB_EXEC_TIMEOUT_S=300
AGENTLAB_EXEC_MEMORY_MB=2048
# Interpreter for sandboxed code; defaults to the backend's own Python.
# AGENTLAB_EXEC_PYTHON=/opt/research-venv/bin/python

# Probe cited URLs before export (the groundedness gate).
AGENTLAB_CHECK_URLS=true
AGENTLAB_MAX_UPLOAD_MB=10
