# Export these, or copy to .env and load it with: set -a; . ./.env; set +a
# Everything is optional except one model key.

# --- models -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# RESEARCH_PROVIDER=anthropic            # anthropic | openai | deepseek | ollama
# RESEARCH_LEAD_MODEL=claude-opus-5-5
# RESEARCH_SUBAGENT_MODEL=claude-sonnet-5-5
# RESEARCH_CITATION_MODEL=claude-sonnet-5-5
# RESEARCH_JUDGE_MODEL=claude-opus-5-5
# RESEARCH_LEAD_EFFORT=high              # low | medium | high | xhigh | max
# RESEARCH_SUBAGENT_EFFORT=medium
# RESEARCH_THINKING_DISPLAY=summarized   # summarized | omitted
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible API (OpenRouter, LM Studio, ...)
# DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- search -----------------------------------------------------------------
# RESEARCH_SEARCH=auto                   # auto | anthropic | tavily | brave | searxng | duckduckgo | none
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=http://localhost:8888
# RESEARCH_CORPUS=/path/to/your/notes    # local documents the agents can search

# --- limits and storage -------------------------------------------------------
# RESEARCH_MAX_USD=5
# RESEARCH_MAX_SUBAGENTS=18
# RESEARCH_PARALLEL_SUBAGENTS=5
# RESEARCH_MAX_MINUTES=45
# RESEARCH_LEAD_CONTEXT_TOKENS=160000
# RESEARCH_DATA_DIR=research-data
# RESEARCH_PROMPTS_DIR=                  # edited prompts (research-agent prompts --dump DIR)
# RESEARCH_TRACE_CONTENT=1               # 0 = traces keep structure only, no content
# RESEARCH_MAX_RETRIES=4
# RESEARCH_AGENT_TOKEN=                  # required bearer token for `serve`
