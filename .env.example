# Supabase — server-side
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Supabase — exposed to the browser (VITE_* is public by design)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Base URL the browser uses for /api calls
VITE_API_BASE=

# Optional: dev-server proxy target for /api (default http://localhost:8000)
# VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: HMAC secret for the stateless agentlab_session cookie (Worker env var)
# SESSION_SECRET=
