# Supabase (optional). VITE_* values are inlined into the client bundle at
# build time, so they must be set when you run `npm run build`. Publishable
# keys only — never put a service-role key here. Leave these empty to use the
# backend's own email/password accounts instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# SSR fallback, read at runtime from process.env when the VITE_* pair is absent.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Base URL of the research backend in backend/ (run it with `npm run backend`).
VITE_API_BASE=http://localhost:8000

# Optional: dev-server proxy target for /api (default http://127.0.0.1:8000)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
